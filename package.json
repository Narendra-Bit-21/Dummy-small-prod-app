{
  "name": "quickpay-and-notify-studio",
  "version": "1.0.0",
  "description": "Production-grade ₹1 Payments (Razorpay + Direct NPCI UPI QR) with Instant Multi-Channel Alerts (Email, WhatsApp, SMS) and SQLite persistence",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "postinstall": "npm --prefix backend install",
    "docker:build": "docker compose -f deploy/docker-compose.yml build",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d",
    "docker:down": "docker compose -f deploy/docker-compose.yml down",
    "docker:logs": "docker compose -f deploy/docker-compose.yml logs -f",
    "healthcheck": "bash deploy/healthcheck.sh"
  },
  "keywords": [
    "razorpay",
    "upi",
    "payments",
    "notifications",
    "email",
    "whatsapp",
    "sms",
    "docker",
    "aws-free-tier",
    "sqlite"
  ],
  "author": "Engineering Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.15",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "sqlite3": "^5.1.7"
  }
}
