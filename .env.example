# ==============================================================================
# QuickPay & Notify Studio - Production & Development Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# SQLite Database Location
DATABASE_PATH=/app/database/app.db
DB_PATH=/app/database/app.db

# ------------------------------------------------------------------------------
# 1. PAYMENT GATEWAY: RAZORPAY CONFIGURATION (Test / Live)
# Dashboard: https://dashboard.razorpay.com/app/keys
# Test Mode works immediately without KYC!
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_51MockKeyId99
RAZORPAY_KEY_SECRET=mock_secret_replace_in_prod
RAZORPAY_WEBHOOK_SECRET=quickpay_webhook_secret_key_123

# ------------------------------------------------------------------------------
# 2. ZERO-FEE DIRECT NPCI UPI QR CONFIGURATION
# Direct UPI VPA that receives direct customer payments at ₹0 merchant fee
# ------------------------------------------------------------------------------
UPI_VPA=ravi123sehravat@okaxis
UPI_PAYEE_NAME=Ravi Sehrawat

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS: GMAIL SMTP CONFIGURATION
# Uses Gmail SMTP (Port 465 SSL / 587 TLS). Generate an App Password in:
# Google Account -> Security -> 2-Step Verification -> App Passwords
# ------------------------------------------------------------------------------
GMAIL_USER=ravi123sehravat@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM_NAME="Payment & Alerts Notification Hub"

# Compatible aliases
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ravi123sehravat@gmail.com
EMAIL_PASS=your_16_char_app_password

# ------------------------------------------------------------------------------
# 4. WHATSAPP & SMS: TWILIO REST CONFIGURATION
# Twilio Console: https://console.twilio.com/
# Free Trial includes $15+ credits and WhatsApp Sandbox
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid_replace
TWILIO_AUTH_TOKEN=mock_twilio_auth_token_replace
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=

# Compatible aliases
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# ------------------------------------------------------------------------------
# 5. ALTERNATIVE INDIAN SMS GATEWAY: FAST2SMS (Optional)
# Get API key from https://www.fast2sms.com/
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=
