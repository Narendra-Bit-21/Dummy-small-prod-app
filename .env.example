# ==============================================================================
# QuickPay & Notify Studio - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# SQLite Database Location
DATABASE_PATH=./database/app.db

# Auto-dispatch notifications on payment confirmation (true/false)
AUTO_NOTIFY_ON_PAYMENT=false

# Admin token for protecting recipient write routes (optional)
# If set, POST/PUT /api/recipients requires x-admin-token header
ADMIN_TOKEN=

# ==============================================================================
# 1. CASHFREE PAYMENTS (optional alternative to Razorpay)
# ==============================================================================
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# ==============================================================================
# 2. RAZORPAY PAYMENT GATEWAY
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ==============================================================================
# 3. DIRECT UPI (NPCI QR)
# ==============================================================================
UPI_VPA=yourname@upi
UPI_PAYEE_NAME=Your Name

# ==============================================================================
# 4. RESEND EMAIL API (Primary — works on Railway)
# Get your API key at resend.com
# ==============================================================================
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
# Override recipient email (required on free Resend plan without custom domain)
RESEND_TO_OVERRIDE=your@email.com

# ==============================================================================
# 5. GMAIL SMTP (Fallback — blocked on Railway, works locally)
# ==============================================================================
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM_NAME=Payment & Alerts Hub

# ==============================================================================
# 6. TWILIO (WhatsApp + SMS)
# ==============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ==============================================================================
# 7. FAST2SMS (Indian SMS Gateway — optional, Twilio used as fallback)
# ==============================================================================
FAST2SMS_API_KEY=your_fast2sms_api_key
