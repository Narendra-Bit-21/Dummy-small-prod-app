# ==============================================================
# QuickPay & Notify Studio - Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# SQLite Database Location
DATABASE_PATH=../database/app.db

# Auto-dispatch notifications on payment confirmation (true/false)
AUTO_NOTIFY_ON_PAYMENT=false

# Admin token for protecting recipient write routes (optional)
ADMIN_TOKEN=

# --------------------------------------------------------------
# 1. CASHFREE PAYMENTS (optional alternative to Razorpay)
# --------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# --------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY
# Get keys at: https://dashboard.razorpay.com/app/keys
# --------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --------------------------------------------------------------
# 3. DIRECT UPI (NPCI QR)
# --------------------------------------------------------------
UPI_VPA=yourname@upi
UPI_PAYEE_NAME=Your Name

# --------------------------------------------------------------
# 4. RESEND EMAIL API (Primary — works on Railway)
# Get API key at: https://resend.com
# --------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_OVERRIDE=your@email.com

# --------------------------------------------------------------
# 5. GMAIL SMTP (Fallback — blocked on Railway, works locally)
# Google Account -> Security -> App Passwords
# --------------------------------------------------------------
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM_NAME=Payment & Alerts Hub

# --------------------------------------------------------------
# 6. TWILIO (WhatsApp + SMS)
# https://console.twilio.com/
# --------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --------------------------------------------------------------
# 7. FAST2SMS (Indian SMS Gateway — optional, Twilio as fallback)
# https://www.fast2sms.com/
# --------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key
