# ==============================================================
# Production & Development Environment Configuration
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# SQLite Database Location (defaults to ../database/app.db or memory/JSON fallback)
DATABASE_PATH=../database/app.db

# --------------------------------------------------------------
# 1. PAYMENT GATEWAY: RAZORPAY CONFIGURATION (Test / Live)
# --------------------------------------------------------------
# Get your API keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# --------------------------------------------------------------
# 2. ZERO-FEE DIRECT NPCI UPI QR CONFIGURATION
# --------------------------------------------------------------
# Direct UPI VPA that receives direct customer payments at ₹0 merchant fee
UPI_VPA=ravi123sehravat@okaxis
UPI_PAYEE_NAME=Ravi Sehrawat

# --------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS: GMAIL SMTP CONFIGURATION
# --------------------------------------------------------------
# Uses Gmail SMTP (Port 465 SSL). Generate an App Password in
# Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=ravi123sehravat@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM_NAME=Payment & Alerts Notification Hub

# --------------------------------------------------------------
# 4. WHATSAPP & SMS: TWILIO REST CONFIGURATION
# --------------------------------------------------------------
# Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=

# --------------------------------------------------------------
# 5. ALTERNATIVE INDIAN SMS GATEWAY: FAST2SMS (Optional)
# --------------------------------------------------------------
# Get API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=
